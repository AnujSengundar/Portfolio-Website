{
  "framework": "vite",
  "functions": { "api/blog.js": { "maxDuration": 300 } },
  "crons": [{ "path": "/api/blog?action=cron", "schedule": "30 3 * * *" }],
  "rewrites": [
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/blog/:slug", "destination": "/index.html" },
    { "source": "/admin/blog", "destination": "/index.html" }
  ]
}
